# ---------------------------------------------------------------------------
# TenderScreen runtime configuration
#
# This file is loaded by docker-compose as the documented default
# configuration, so `docker compose up` works from a clean clone with the
# built-in stub model. To change anything (and to add an API key), create a
# file called .env next to this one - it is git-ignored and every value in it
# overrides the value here. Never put a real key in this file.
# ---------------------------------------------------------------------------

# ---- model provider --------------------------------------------------------
# Default: the llm-stub container (OpenAI-compatible, fixed responses after a
# realistic delay). To use a free-tier provider instead, put these four lines
# in .env with your provider's OpenAI-compatible base URL, key and model id:
#   LLM_PROVIDER_NAME=<provider name for dashboards>
#   LLM_BASE_URL=<https://.../v1 (OpenAI-compatible endpoint)>
#   LLM_API_KEY=<your key>
#   LLM_MODEL=<model id from the provider's model list>
LLM_PROVIDER_NAME=stub
LLM_BASE_URL=http://llm-stub:8200/v1
LLM_API_KEY=
# no model identifier is kept in the repository; the stub ignores it, a real
# provider needs it in .env
LLM_MODEL=

# Optional real model on this machine, no key needed (Compose profile "local-llm"):
#   LLM_PROVIDER_NAME=ollama-local
#   LLM_BASE_URL=http://ollama:11434/v1
#   LLM_MODEL=tenderscreen-local          (alias created by ollama-pull, 4096-token context)
#   OLLAMA_MODEL=<model id from the Ollama library, e.g. a 1-3B instruct model>
#   LLM_PROVIDER_TIMEOUT_S=120
#   LLM_CALL_TIMEOUT_S=150
#   RUN_TIMEOUT_S=600
# then: docker compose --profile local-llm up -d
OLLAMA_MODEL=

# list prices (USD per 1M tokens) used to record cost at call time; set them to
# your model's published price. Free tiers cost 0 but the list-price
# equivalent is what the cost-per-100-runs report uses.
LLM_PRICE_INPUT_PER_1M=0.10
LLM_PRICE_OUTPUT_PER_1M=0.40
LLM_DAILY_BUDGET_USD=1.00

# reliability (A5)
LLM_PROVIDER_TIMEOUT_S=20
LLM_CALL_TIMEOUT_S=30
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE_S=0.5
BREAKER_FAILURE_THRESHOLD=5
BREAKER_OPEN_SECONDS=20
LLM_CACHE_ENABLED=true
LLM_CACHE_TTL_S=86400

# stub behaviour (load tests use the stub so they measure this system, not a free tier)
STUB_DELAY_MS=800
STUB_JITTER_MS=200
STUB_MODE=ok

# ---- embeddings / retrieval -------------------------------------------------
# local sentence-embedding model, run with the ONNX runtime and downloaded once
# into the index-data volume on first start. Left empty, the embedding
# library's own default small English model is used, so no model identifier is
# stored in the repository; to choose another, set EMBEDDING_MODEL in .env.
# The model actually used is recorded in the index metadata (/v1/system).
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=
# if the model cannot be downloaded, fall back to hashing embeddings ("hash")
# or fail ("none")
EMBEDDING_FALLBACK=hash
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_K=4
RETRIEVAL_MODE=hybrid
RETRIEVAL_CACHE_ENABLED=true
RETRIEVAL_CACHE_TTL_S=3600

# ---- agents ----------------------------------------------------------------
PROMPT_VERSION=v2
AGENT_MAX_STEPS=12
AGENT_MAX_TOOL_CALLS=16
RUN_TIMEOUT_S=90
TOOL_TIMEOUT_S=10
MAX_VERIFICATION_ATTEMPTS=2
# always add a fixed category policy search when a relaxation may apply (see EVALUATION.md, S11)
AGENT_POLICY_SAFEGUARD=true
QUEUE_LEASE_MS=60000
QUEUE_MAX_DELIVERIES=3
LIVE_EVAL_SAMPLE_RATE=0.25

# ---- API -------------------------------------------------------------------
API_PORT=8000
RATE_LIMIT_PER_MIN=30
RUN_CACHE_ENABLED=true
# enables the demo controls (fault injection, provider outage switch)
DEMO_MODE=true

# ---- internal service endpoints (container network) --------------------------
REDIS_URL=redis://redis:6379/0
LLM_GATEWAY_URL=http://llm-gateway:8100
LLM_STUB_ADMIN_URL=http://llm-stub:8200
OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
CORPUS_DIR=/app/corpus
INDEX_DIR=/data/index
MODEL_CACHE_DIR=/data/models
PROMPTS_DIR=/app/prompts
EXAMPLES_DIR=/app/examples
LOG_LEVEL=INFO

# ---- Grafana (optional; put in .env) -----------------------------------------
# GF_SECURITY_ADMIN_PASSWORD=<choose one>
